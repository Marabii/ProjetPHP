{% extends 'base.html.twig' %}

{% block title %}{{ book.title }}{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="{{ path('app_main') }}">Home</a></li>
                    <li class="breadcrumb-item"><a href="{{ path('app_book_index') }}">Books</a></li>
                    <li class="breadcrumb-item active" aria-current="page">{{ book.title }}</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-4 mb-4">
            <div class="card">
                <img src="{{ book.cover }}" class="card-img-top" alt="{{ book.title }}" style="height: 500px; object-fit: cover;">
                <div class="card-body text-center">
                    <h5 class="card-title">Status</h5>
                    {% if book.status.value == 'available' %}
                        <span class="badge bg-success fs-6">
                            <i class="fas fa-check-circle"></i> {{ book.status.label }}
                        </span>
                    {% elseif book.status.value == 'borrowed' %}
                        <span class="badge bg-warning fs-6">
                            <i class="fas fa-clock"></i> {{ book.status.label }}
                        </span>
                    {% else %}
                        <span class="badge bg-danger fs-6">
                            <i class="fas fa-times-circle"></i> {{ book.status.label }}
                        </span>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h1 class="card-title mb-0">{{ book.title }}</h1>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-sm-3"><strong><i class="fas fa-barcode"></i> ISBN:</strong></div>
                        <div class="col-sm-9">{{ book.isbn }}</div>
                    </div>
                    
                    <div class="row mb-3">
                        <div class="col-sm-3"><strong><i class="fas fa-user-edit"></i> Authors:</strong></div>
                        <div class="col-sm-9">
                            {% for author in book.authors %}
                                <a href="{{ path('app_author_show', {'id': author.id}) }}" class="badge bg-secondary text-decoration-none me-1">
                                    {{ author.name }}
                                </a>
                            {% endfor %}
                        </div>
                    </div>
                    
                    <div class="row mb-3">
                        <div class="col-sm-3"><strong><i class="fas fa-building"></i> Publisher:</strong></div>
                        <div class="col-sm-9">
                            <a href="{{ path('app_publisher_show', {'id': book.editor.id}) }}" class="badge bg-info text-decoration-none">
                                {{ book.editor.name }}
                            </a>
                        </div>
                    </div>
                    
                    <div class="row mb-3">
                        <div class="col-sm-3"><strong><i class="fas fa-calendar"></i> Published:</strong></div>
                        <div class="col-sm-9">{{ book.editedAt|date('F j, Y') }}</div>
                    </div>
                    
                    <div class="row mb-3">
                        <div class="col-sm-3"><strong><i class="fas fa-file-alt"></i> Pages:</strong></div>
                        <div class="col-sm-9">{{ book.pageNumber }} pages</div>
                    </div>
                    
                    {% if book.plot %}
                    <div class="row mb-3">
                        <div class="col-sm-3"><strong><i class="fas fa-book-open"></i> Plot:</strong></div>
                        <div class="col-sm-9">
                            <p class="text-justify">{{ book.plot|nl2br }}</p>
                        </div>
                    </div>
                    {% endif %}
                </div>
            </div>

            <!-- Comments Section -->
            {% if book.comments|length > 0 %}
            <div class="card mt-4">
                <div class="card-header">
                    <h3><i class="fas fa-comments"></i> Comments ({{ book.comments|length }})</h3>
                </div>
                <div class="card-body">
                    {% for comment in book.comments %}
                    <div class="border-bottom pb-3 mb-3">
                        <div class="d-flex justify-content-between">
                            <strong>{{ comment.name }}</strong>
                            <small class="text-muted">{{ comment.createdAt|date('F j, Y') }}</small>
                        </div>
                        <p class="mt-2">{{ comment.content|nl2br }}</p>
                    </div>
                    {% endfor %}
                </div>
            </div>
            {% endif %}
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <a href="{{ path('app_book_index') }}" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Back to Books
            </a>
        </div>
    </div>
</div>
{% endblock %}
