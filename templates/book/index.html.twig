{% extends 'base.html.twig' %}

{% block title %}Books Catalog{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h1 class="mb-4">
                <i class="fas fa-book"></i> Books Catalog
                <span class="badge bg-primary">{{ books|length }} books</span>
            </h1>
        </div>
    </div>

    <div class="row">
        {% for book in books %}
        <div class="col-xl-3 col-lg-4 col-md-6 mb-4">
            <div class="card h-100 shadow-sm">
                <img src="{{ book.cover }}" class="card-img-top" alt="{{ book.title }}" style="height: 300px; object-fit: cover;">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">{{ book.title }}</h5>
                    <p class="card-text">
                        <small class="text-muted">
                            <i class="fas fa-barcode"></i> ISBN: {{ book.isbn }}
                        </small>
                    </p>
                    <p class="card-text">
                        <small class="text-muted">
                            <i class="fas fa-calendar"></i> Published: {{ book.editedAt|date('Y-m-d') }}
                        </small>
                    </p>
                    <p class="card-text">
                        <small class="text-muted">
                            <i class="fas fa-file-alt"></i> {{ book.pageNumber }} pages
                        </small>
                    </p>
                    <p class="card-text">
                        {% for author in book.authors %}
                            <span class="badge bg-secondary me-1">{{ author.name }}</span>
                        {% endfor %}
                    </p>
                    <p class="card-text">
                        <span class="badge bg-info">{{ book.editor.name }}</span>
                    </p>
                    <p class="card-text">
                        {% if book.status.value == 'available' %}
                            <span class="badge bg-success">
                                <i class="fas fa-check-circle"></i> {{ book.status.label }}
                            </span>
                        {% elseif book.status.value == 'borrowed' %}
                            <span class="badge bg-warning">
                                <i class="fas fa-clock"></i> {{ book.status.label }}
                            </span>
                        {% else %}
                            <span class="badge bg-danger">
                                <i class="fas fa-times-circle"></i> {{ book.status.label }}
                            </span>
                        {% endif %}
                    </p>
                    <div class="mt-auto">
                        <a href="{{ path('app_book_show', {'id': book.id}) }}" class="btn btn-primary w-100">
                            <i class="fas fa-eye"></i> View Details
                        </a>
                    </div>
                </div>
            </div>
        </div>
        {% else %}
        <div class="col-12">
            <div class="alert alert-info text-center">
                <i class="fas fa-info-circle"></i> No books found in the catalog.
            </div>
        </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
