{% extends 'base.html.twig' %}

{% block title %}Publishers{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h1 class="mb-4">
                <i class="fas fa-building"></i> Publishers
                <span class="badge bg-primary">{{ publishers|length }} publishers</span>
            </h1>
        </div>
    </div>

    <div class="row">
        {% for publisher in publishers %}
        <div class="col-xl-3 col-lg-4 col-md-6 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">
                        <i class="fas fa-building"></i> {{ publisher.name }}
                    </h5>
                    
                    <p class="card-text">
                        <span class="badge bg-info">
                            <i class="fas fa-book"></i> {{ publisher.books|length }} book(s)
                        </span>
                    </p>
                    
                    <div class="mt-auto">
                        <a href="{{ path('app_publisher_show', {'id': publisher.id}) }}" class="btn btn-primary w-100">
                            <i class="fas fa-eye"></i> View Details
                        </a>
                    </div>
                </div>
            </div>
        </div>
        {% else %}
        <div class="col-12">
            <div class="alert alert-info text-center">
                <i class="fas fa-info-circle"></i> No publishers found.
            </div>
        </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
