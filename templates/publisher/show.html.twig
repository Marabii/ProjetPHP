{% extends 'base.html.twig' %}

{% block title %}{{ publisher.name }}{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="{{ path('app_main') }}">Home</a></li>
                    <li class="breadcrumb-item"><a href="{{ path('app_publisher_index') }}">Publishers</a></li>
                    <li class="breadcrumb-item active" aria-current="page">{{ publisher.name }}</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-4 mb-4">
            <div class="card">
                <div class="card-header">
                    <h3><i class="fas fa-building"></i> Publisher Information</h3>
                </div>
                <div class="card-body">
                    <h4 class="card-title">{{ publisher.name }}</h4>
                    
                    <div class="mb-3">
                        <strong><i class="fas fa-book"></i> Total Books:</strong><br>
                        <span class="badge bg-primary fs-6">{{ publisher.books|length }} book(s)</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h3><i class="fas fa-book"></i> Books by {{ publisher.name }}</h3>
                </div>
                <div class="card-body">
                    {% if publisher.books|length > 0 %}
                    <div class="row">
                        {% for book in publisher.books %}
                        <div class="col-lg-6 mb-4">
                            <div class="card h-100">
                                <img src="{{ book.cover }}" class="card-img-top" alt="{{ book.title }}" style="height: 200px; object-fit: cover;">
                                <div class="card-body d-flex flex-column">
                                    <h6 class="card-title">{{ book.title }}</h6>
                                    <p class="card-text">
                                        <small class="text-muted">
                                            <i class="fas fa-calendar"></i> {{ book.editedAt|date('Y-m-d') }}
                                        </small>
                                    </p>
                                    <p class="card-text">
                                        <small class="text-muted">
                                            <i class="fas fa-file-alt"></i> {{ book.pageNumber }} pages
                                        </small>
                                    </p>
                                    <p class="card-text">
                                        {% for author in book.authors %}
                                            <span class="badge bg-secondary me-1">{{ author.name }}</span>
                                        {% endfor %}
                                    </p>
                                    <p class="card-text">
                                        {% if book.status.value == 'available' %}
                                            <span class="badge bg-success">
                                                <i class="fas fa-check-circle"></i> {{ book.status.label }}
                                            </span>
                                        {% elseif book.status.value == 'borrowed' %}
                                            <span class="badge bg-warning">
                                                <i class="fas fa-clock"></i> {{ book.status.label }}
                                            </span>
                                        {% else %}
                                            <span class="badge bg-danger">
                                                <i class="fas fa-times-circle"></i> {{ book.status.label }}
                                            </span>
                                        {% endif %}
                                    </p>
                                    <div class="mt-auto">
                                        <a href="{{ path('app_book_show', {'id': book.id}) }}" class="btn btn-primary w-100">
                                            <i class="fas fa-eye"></i> View Details
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                    {% else %}
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle"></i> No books found for this publisher.
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <a href="{{ path('app_publisher_index') }}" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Back to Publishers
            </a>
        </div>
    </div>
</div>
{% endblock %}
